{
  "name": "project-manager",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:push": "pnpm --filter @repo/db push",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:studio": "pnpm --filter @repo/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.41.0"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
