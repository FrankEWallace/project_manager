{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --target=node20 --outfile=api/index.js --format=esm --external:@hono/node-server --external:@hono/zod-validator --external:@paralleldrive/cuid2 --external:better-auth --external:dotenv --external:drizzle-orm --external:hono --external:resend --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.7.6",
    "@paralleldrive/cuid2": "^2.3.1",
    "@repo/db": "workspace:*",
    "@repo/validators": "workspace:*",
    "better-auth": "^1.6.9",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.9",
    "resend": "^6.12.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
